# ==============================================================================
# Hiver Support Agent Configuration (.env)
# ==============================================================================

# Required: Free Groq API key (Sign up in 30s at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: LLM model selection (Default: qwen/qwen3.6-27b or llama-3.3-70b-versatile)
GROQ_MODEL=qwen/qwen3.6-27b

# Optional: Evaluation Judge Model
GROQ_JUDGE_MODEL=openai/gpt-oss-20b

# Vector Knowledge Base Persist Directory (Included out-of-the-box)
CHROMA_PERSIST_DIR=./data/chroma_db